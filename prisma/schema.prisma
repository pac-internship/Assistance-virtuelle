generator client {
  provider = "prisma-client-js"
  output   = "./../lib/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model message {
  id         Int      @id @default(autoincrement())
  titre      String?
  content    String
  idChatroom Int
  chatroom   Chatroom @relation(fields: [idChatroom], references: [id], map: "Message_idChatroom_fkey")

  @@index([idChatroom], map: "Message_idChatroom_fkey")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  chatroom      Chatroom[]
  sessions      Session[]
}

model Chatroom {
  id      Int       @id @default(autoincrement())
  titre   String?
  status  String
  idUser  String
  user    User      @relation(fields: [idUser], references: [id], map: "Chatroom_idUser_fkey")
  message message[]

  @@index([idUser], map: "Chatroom_idUser_fkey")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "Session_userId_fkey")
}

model question {
  id       Int        @id @default(autoincrement())
  contenu  String
  parentId Int?
  parent   question?  @relation("SubQuestions", fields: [parentId], references: [id])
  children question[] @relation("SubQuestions")
  reponses reponse[]

  @@index([parentId], map: "question_parentId_fkey")
}

model reponse {
  id         Int      @id @default(autoincrement())
  contenu    String
  questionId Int
  question   question @relation(fields: [questionId], references: [id])

  @@index([questionId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
